    59 00000007 8ED0                        mov ss, ax
    60 00000009 BC0078                      mov sp, STAGE2_STACK_TOP
    61 0000000C FC                          cld
    62 0000000D FB                          sti
    63                                  
    64 0000000E 8816[E87A]                  mov [boot_drive], dl
    64          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    65 00000012 BE[D87B]                    mov si, message_start
    65          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    66 00000015 E8AE7A                      call print_string
    67                                  
    68 00000018 E81E00                      call initialize_bib
    69 0000001B E8A701                      call collect_cpu_and_entropy
    70 0000001E E83002                      call collect_memory_map
    71 00000021 E89602                      call initialize_vbe
    72 00000024 E82E03                      call load_kernel_image
    73 00000027 E84B04                      call validate_kernel_image
    74 0000002A E83E0D                      call finalize_bib
    75 0000002D E8590D                      call validate_bib
    76 00000030 E8CE0D                      call enable_a20
    77 00000033 E8DD0D                      call enter_protected_mode
    78 00000036 E9A37A                      jmp fatal_halt
