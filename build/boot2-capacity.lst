    81                                  ; Boot Information Block v1
    82                                  ; Alle TLVs sind 8-Byte-ausgerichtet und Little-Endian kodiert.
    83                                  ; ---------------------------------------------------------------------------
    84                                  
    85                                  initialize_bib:
    86 00000039 31C0                        xor ax, ax
    87 0000003B 8EC0                        mov es, ax
    88 0000003D BF0050                      mov di, BOOT_INFO_ADDRESS
    89 00000040 B90004                      mov cx, BOOT_INFO_CAPACITY / 2
    90 00000043 F3AB                        rep stosw
    91                                  
    92 00000045 66C70600504E424850          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_MAGIC_LOW], NOVA_BIB_MAGIC_LOW
    93 0000004E 66C706045042494200          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_MAGIC_HIGH], NOVA_BIB_MAGIC_HIGH
    94 00000057 C70608500100                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_MAJOR], NOVA_BIB_VERSION_MAJOR
    95 0000005D C7060A500200                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_MINOR], NOVA_BIB_VERSION_MINOR
    96 00000063 C7060C500000                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_PATCH], NOVA_BIB_VERSION_PATCH
    97 00000069 C7060E502000                mov word [BOOT_INFO_ADDRESS + BIB_OFF_HEADER_SIZE], NOVA_BIB_HEADER_SIZE
    98 0000006F 66C7061050D0010000          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_TOTAL_SIZE], BIB_TOTAL_SIZE
    99 00000078 66C706185001000000          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_ARCHITECTURE], NKI_ARCH_X86_32
   100                                  
   101                                      ; Firmware TLV
   102 00000081 C70620500100                mov word [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 0], BIB_TLV_FIRMWARE
   103 00000087 C70622500100                mov word [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   104 0000008D 66C706245010000000          mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 4], BIB_FIRMWARE_SIZE
   105 00000096 66C706285001000000          mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 8], NOVA_BOOT_PLATFORM_BIOS
   106 0000009F 6631C0                      xor eax, eax
   107 000000A2 A0[E87A]                    mov al, [boot_drive]
   107          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
   108 000000A5 66A32C50                    mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 12], eax
   109                                  
   110                                      ; Memory TLV
   111 000000A9 C70638500300                mov word [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 0], BIB_TLV_MEMORY
   112 000000AF C7063A500100                mov word [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   113 000000B5 66C7063C5010000000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 4], BIB_MEMORY_SIZE
   114 000000BE 66C706405000580000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 8], MEMORY_MAP_ADDRESS
   115 000000C7 66C706485018000000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 16], MEMORY_MAP_ENTRY_SIZE
   116                                  
   117                                      ; Graphics TLV
   118 000000D0 C70650500400                mov word [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 0], BIB_TLV_GRAPHICS
   119 000000D6 66C706545020000000          mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 4], BIB_GRAPHICS_SIZE
   120                                  
   121                                      ; Kernel TLV
   122 000000DF C70678500600                mov word [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 0], BIB_TLV_KERNEL
   123 000000E5 C7067A500100                mov word [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   124 000000EB 66C7067C5020000000          mov dword [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 4], BIB_KERNEL_SIZE
   125                                  
   126                                      ; Security TLV: Status 0 = nicht verifiziert, transparent gemeldet.
   127 000000F4 C706A0500700                mov word [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 0], BIB_TLV_SECURITY
   128 000000FA C706A2500100                mov word [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   129 00000100 66C706A45010000000          mov dword [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 4], BIB_SECURITY_SIZE
   130                                  
   131                                      ; Boot Options TLV: Standardprofil, kein Debug-/Recovery-Modus.
   132 00000109 C706B8500900                mov word [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 0], BIB_TLV_BOOT_OPTIONS
   133 0000010F C706BA500100                mov word [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   134 00000115 66C706BC5010000000          mov dword [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 4], BIB_BOOT_OPTIONS_SIZE
   135                                  
   136                                      ; Erweiterte NBHP/BIB-1.1-Informationen. Nicht verfügbare optionale
   137                                      ; Zeiger bleiben null und werden dadurch nicht als gültig ausgegeben.
