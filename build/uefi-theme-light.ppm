קעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפ