פקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפק8<BU[cU[cU[cU[c8<B!עפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקU[c8<BעפקעפקעפקעפקU[c8<Bעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפק8<BU[cעפקעפקעפקעפקעפקעפקעפקעפק8<B8<BעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקU[c8<Bעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפק8<BU[cU[cU[cU[cU[cU[cU[cעפקעפקעפקעפקU[c8<BעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקU[c8<Bעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפק8<B8<Bעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפ