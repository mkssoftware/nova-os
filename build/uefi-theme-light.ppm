עפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפ