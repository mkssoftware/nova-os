קעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקU[c½ÁÅעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפקעפק