   120 000000F4 C706A0500700                mov word [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 0], BIB_TLV_SECURITY
   121 000000FA C706A2500100                mov word [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   122 00000100 66C706A45010000000          mov dword [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 4], BIB_SECURITY_SIZE
   123                                  
   124                                      ; Boot Options TLV: Standardprofil, kein Debug-/Recovery-Modus.
   125 00000109 C706B8500900                mov word [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 0], BIB_TLV_BOOT_OPTIONS
   126 0000010F C706BA500100                mov word [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   127 00000115 66C706BC5010000000          mov dword [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 4], BIB_BOOT_OPTIONS_SIZE
