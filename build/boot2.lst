   116 000000E5 C7067A500100                mov word [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 2], BIB_TLV_FLAG_REQUIRED
   117 000000EB 66C7067C5020000000          mov dword [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 4], BIB_KERNEL_SIZE
