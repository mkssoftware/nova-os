  1481 000021BC E621                        out PIC1_DATA, al
  1482 000021BE E8EC000000                  call io_wait
  1483 000021C3 B002                        mov al, 0x02
  1484 000021C5 E6A1                        out PIC2_DATA, al
  1485 000021C7 E8E3000000                  call io_wait
  1486 000021CC B001                        mov al, 0x01
  1487 000021CE E621                        out PIC1_DATA, al
  1488 000021D0 E8DA000000                  call io_wait
  1489 000021D5 E6A1                        out PIC2_DATA, al
