     1                                  ; Nova Boot Manager - BIOS Stage 2
     2                                  ; Referenzimplementierung für NKI v1 und NBHP/BIB v1.
     3                                  
     4                                  %include "layout.inc"
     1                              <1> ; Gemeinsames physisches Speicher- und Datenträgerlayout des BIOS-Bootpfads.
     2                              <1> ; Änderungen an diesen Konstanten müssen zusammen mit Image Builder,
     3                              <1> ; Kernel-Linkerskript und BootInfo-ABI erfolgen.
     4                              <1> 
     5                              <1> %ifndef NOVA_BOOT_LAYOUT_INC
     6                              <1> %define NOVA_BOOT_LAYOUT_INC
     7                              <1> 
     8                              <1> ; Datenträgerlayout
     9                              <1> STAGE2_FIRST_SECTOR        equ 2
    10                              <1> STAGE2_SECTOR_COUNT        equ 32
    11                              <1> STAGE2_BYTE_COUNT          equ STAGE2_SECTOR_COUNT * 512
    12                              <1> KERNEL_FIRST_LBA           equ 33
    13                              <1> KERNEL_PAYLOAD_MAX_SIZE    equ 32768
    14                              <1> NKI_HEADER_SIZE            equ 64
    15                              <1> KERNEL_IMAGE_SECTOR_COUNT  equ 65
    16                              <1> KERNEL_IMAGE_BYTE_COUNT    equ KERNEL_IMAGE_SECTOR_COUNT * 512
    17                              <1> 
    18                              <1> DISK_RETRY_COUNT           equ 3
    19                              <1> 
    20                              <1> ; Physisches Speicherlayout unterhalb von 1 MiB
    21                              <1> BOOT_INFO_ADDRESS          equ 0x00005000
    22                              <1> BOOT_INFO_CAPACITY         equ 0x00000800
    23                              <1> MEMORY_MAP_ADDRESS         equ 0x00005800
    24                              <1> MEMORY_MAP_ENTRY_SIZE      equ 24
    25                              <1> MEMORY_MAP_MAX_ENTRIES     equ 64
    26                              <1> VBE_MODE_INFO_ADDRESS      equ 0x00006000
    27                              <1> STAGE2_STACK_TOP           equ 0x00007800
    28                              <1> STAGE1_STACK_TOP           equ 0x00007C00
    29                              <1> STAGE2_LOAD_ADDRESS        equ 0x00007E00
    30                              <1> 
    31                              <1> KERNEL_TEMP_SEGMENT        equ 0x1000
    32                              <1> KERNEL_TEMP_OFFSET         equ 0x0000
    33                              <1> KERNEL_TEMP_ADDRESS        equ 0x00010000
    34                              <1> 
    35                              <1> ; 32-Bit-Kernel
    36                              <1> KERNEL_ENTRY_ADDRESS       equ 0x00100000
    37                              <1> KERNEL_STACK_TOP           equ 0x00090000
    38                              <1> 
    39                              <1> ; Protected-Mode-Segmente
    40                              <1> CODE_SEGMENT               equ 0x08
    41                              <1> DATA_SEGMENT               equ 0x10
    42                              <1> 
    43                              <1> ; Grafik
    44                              <1> ; QEMU/Bochs VBE: 800 x 600 x 32 Bit mit linearem Framebuffer.
    45                              <1> ; Der klassische Modus 0x118 besitzt nur 24 Bit und darf nicht als
    46                              <1> ; BGRX8888 an den Kernel übergeben werden.
    47                              <1> VBE_REQUESTED_MODE         equ 0x0143
    48                              <1> NOVA_PIXEL_FORMAT_BGRX8888 equ 1
    49                              <1> 
    50                              <1> ; Nova Kernel Image v1 (NKI)
    51                              <1> NKI_MAGIC_LOW              equ 0x41564F4E ; "NOVA"
    52                              <1> NKI_MAGIC_HIGH             equ 0x00494B4E ; "NKI\0"
    53                              <1> NKI_VERSION                equ 1
    54                              <1> NKI_ARCH_X86_32            equ 1
    55                              <1> NKI_COMPRESSION_NONE       equ 0
    56                              <1> 
    57                              <1> NKI_OFF_MAGIC_LOW          equ 0
    58                              <1> NKI_OFF_MAGIC_HIGH         equ 4
    59                              <1> NKI_OFF_VERSION            equ 8
    60                              <1> NKI_OFF_HEADER_SIZE        equ 12
    61                              <1> NKI_OFF_ARCHITECTURE       equ 16
    62                              <1> NKI_OFF_FLAGS              equ 20
    63                              <1> NKI_OFF_ENTRY_POINT        equ 24
    64                              <1> NKI_OFF_LOAD_ADDRESS       equ 28
    65                              <1> NKI_OFF_IMAGE_SIZE         equ 32
    66                              <1> NKI_OFF_COMPRESSION        equ 36
    67                              <1> NKI_OFF_CRC32              equ 40
    68                              <1> NKI_OFF_BUILD_ID           equ 44
    69                              <1> 
    70                              <1> ; Boot Information Block (BIB) v1
    71                              <1> NOVA_BIB_MAGIC_LOW         equ 0x5048424E ; "NBHP"
    72                              <1> NOVA_BIB_MAGIC_HIGH        equ 0x00424942 ; "BIB\0"
    73                              <1> NOVA_BIB_VERSION_MAJOR     equ 1
    74                              <1> NOVA_BIB_VERSION_MINOR     equ 0
    75                              <1> NOVA_BIB_VERSION_PATCH     equ 0
    76                              <1> NOVA_BIB_HEADER_SIZE       equ 32
    77                              <1> NOVA_X86_BOOT_MAGIC        equ 0x4E4F5641
    78                              <1> NOVA_BOOT_PLATFORM_BIOS    equ 1
    79                              <1> NOVA_BOOT_FLAG_FRAMEBUFFER equ 0x00000001
    80                              <1> 
    81                              <1> BIB_OFF_MAGIC_LOW          equ 0
    82                              <1> BIB_OFF_MAGIC_HIGH         equ 4
    83                              <1> BIB_OFF_VERSION_MAJOR      equ 8
    84                              <1> BIB_OFF_VERSION_MINOR      equ 10
    85                              <1> BIB_OFF_VERSION_PATCH      equ 12
    86                              <1> BIB_OFF_HEADER_SIZE        equ 14
    87                              <1> BIB_OFF_TOTAL_SIZE         equ 16
    88                              <1> BIB_OFF_CHECKSUM           equ 20
    89                              <1> BIB_OFF_ARCHITECTURE       equ 24
    90                              <1> BIB_OFF_FLAGS              equ 28
    91                              <1> 
    92                              <1> BIB_TLV_HEADER_SIZE        equ 8
    93                              <1> BIB_TLV_FIRMWARE           equ 1
    94                              <1> BIB_TLV_MEMORY             equ 3
    95                              <1> BIB_TLV_GRAPHICS           equ 4
    96                              <1> BIB_TLV_KERNEL             equ 6
    97                              <1> BIB_TLV_SECURITY           equ 7
    98                              <1> BIB_TLV_BOOT_OPTIONS       equ 9
    99                              <1> 
   100                              <1> BIB_FIRMWARE_SIZE          equ 16
   101                              <1> BIB_MEMORY_SIZE            equ 16
   102                              <1> BIB_GRAPHICS_SIZE          equ 32
   103                              <1> BIB_KERNEL_SIZE            equ 32
   104                              <1> BIB_SECURITY_SIZE          equ 16
   105                              <1> BIB_BOOT_OPTIONS_SIZE      equ 16
   106                              <1> 
   107                              <1> %endif
     5                                  
     6                                  [org STAGE2_LOAD_ADDRESS]
     7                                  [bits 16]
     8                                  
     9                                  BIB_FIRMWARE_OFFSET     equ NOVA_BIB_HEADER_SIZE
    10                                  BIB_MEMORY_OFFSET       equ BIB_FIRMWARE_OFFSET + BIB_TLV_HEADER_SIZE + BIB_FIRMWARE_SIZE
    11                                  BIB_GRAPHICS_OFFSET     equ BIB_MEMORY_OFFSET + BIB_TLV_HEADER_SIZE + BIB_MEMORY_SIZE
    12                                  BIB_KERNEL_OFFSET       equ BIB_GRAPHICS_OFFSET + BIB_TLV_HEADER_SIZE + BIB_GRAPHICS_SIZE
    13                                  BIB_SECURITY_OFFSET     equ BIB_KERNEL_OFFSET + BIB_TLV_HEADER_SIZE + BIB_KERNEL_SIZE
    14                                  BIB_OPTIONS_OFFSET      equ BIB_SECURITY_OFFSET + BIB_TLV_HEADER_SIZE + BIB_SECURITY_SIZE
    15                                  BIB_TOTAL_SIZE          equ BIB_OPTIONS_OFFSET + BIB_TLV_HEADER_SIZE + BIB_BOOT_OPTIONS_SIZE
    16                                  
    17                                  stage2_start:
    18 00000000 FA                          cli
    19 00000001 31C0                        xor ax, ax
    20 00000003 8ED8                        mov ds, ax
    21 00000005 8EC0                        mov es, ax
    22 00000007 8ED0                        mov ss, ax
    23 00000009 BC0078                      mov sp, STAGE2_STACK_TOP
    24 0000000C FC                          cld
    25 0000000D FB                          sti
    26                                  
    27 0000000E 8816[F02D]                  mov [boot_drive], dl
    28 00000012 BE[0C2E]                    mov si, message_start
    29 00000015 E8B62D                      call print_string
    30                                  
    31 00000018 E81800                      call initialize_bib
    32 0000001B E8DD00                      call collect_memory_map
    33 0000001E E84301                      call initialize_vbe
    34 00000021 E8DB01                      call load_kernel_image
    35 00000024 E8F802                      call validate_kernel_image
    36 00000027 E8DE03                      call finalize_bib
    37 0000002A E8F903                      call enable_a20
    38 0000002D E80804                      call enter_protected_mode
    39 00000030 E9B12D                      jmp fatal_halt
    40                                  
    41                                  ; ---------------------------------------------------------------------------
    42                                  ; Boot Information Block v1
    43                                  ; Alle TLVs sind 8-Byte-ausgerichtet und Little-Endian kodiert.
    44                                  ; ---------------------------------------------------------------------------
    45                                  
    46                                  initialize_bib:
    47 00000033 31C0                        xor ax, ax
    48 00000035 8EC0                        mov es, ax
    49 00000037 BF0050                      mov di, BOOT_INFO_ADDRESS
    50 0000003A B90004                      mov cx, BOOT_INFO_CAPACITY / 2
    51 0000003D F3AB                        rep stosw
    52                                  
    53 0000003F 66C70600504E424850          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_MAGIC_LOW], NOVA_BIB_MAGIC_LOW
    54 00000048 66C706045042494200          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_MAGIC_HIGH], NOVA_BIB_MAGIC_HIGH
    55 00000051 C70608500100                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_MAJOR], NOVA_BIB_VERSION_MAJOR
    56 00000057 C7060A500000                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_MINOR], NOVA_BIB_VERSION_MINOR
    57 0000005D C7060C500000                mov word [BOOT_INFO_ADDRESS + BIB_OFF_VERSION_PATCH], NOVA_BIB_VERSION_PATCH
    58 00000063 C7060E502000                mov word [BOOT_INFO_ADDRESS + BIB_OFF_HEADER_SIZE], NOVA_BIB_HEADER_SIZE
    59 00000069 66C7061050D0000000          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_TOTAL_SIZE], BIB_TOTAL_SIZE
    60 00000072 66C706185001000000          mov dword [BOOT_INFO_ADDRESS + BIB_OFF_ARCHITECTURE], NKI_ARCH_X86_32
    61                                  
    62                                      ; Firmware TLV
    63 0000007B C70620500100                mov word [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 0], BIB_TLV_FIRMWARE
    64 00000081 66C706245010000000          mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 4], BIB_FIRMWARE_SIZE
    65 0000008A 66C706285001000000          mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 8], NOVA_BOOT_PLATFORM_BIOS
    66 00000093 6631C0                      xor eax, eax
    67 00000096 A0[F02D]                    mov al, [boot_drive]
    68 00000099 66A32C50                    mov dword [BOOT_INFO_ADDRESS + BIB_FIRMWARE_OFFSET + 12], eax
    69                                  
    70                                      ; Memory TLV
    71 0000009D C70638500300                mov word [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 0], BIB_TLV_MEMORY
    72 000000A3 66C7063C5010000000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 4], BIB_MEMORY_SIZE
    73 000000AC 66C706405000580000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 8], MEMORY_MAP_ADDRESS
    74 000000B5 66C706485018000000          mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 16], MEMORY_MAP_ENTRY_SIZE
    75                                  
    76                                      ; Graphics TLV
    77 000000BE C70650500400                mov word [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 0], BIB_TLV_GRAPHICS
    78 000000C4 66C706545020000000          mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 4], BIB_GRAPHICS_SIZE
    79                                  
    80                                      ; Kernel TLV
    81 000000CD C70678500600                mov word [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 0], BIB_TLV_KERNEL
    82 000000D3 66C7067C5020000000          mov dword [BOOT_INFO_ADDRESS + BIB_KERNEL_OFFSET + 4], BIB_KERNEL_SIZE
    83                                  
    84                                      ; Security TLV: Status 0 = nicht verifiziert, transparent gemeldet.
    85 000000DC C706A0500700                mov word [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 0], BIB_TLV_SECURITY
    86 000000E2 66C706A45010000000          mov dword [BOOT_INFO_ADDRESS + BIB_SECURITY_OFFSET + 4], BIB_SECURITY_SIZE
    87                                  
    88                                      ; Boot Options TLV: Standardprofil, kein Debug-/Recovery-Modus.
    89 000000EB C706B8500900                mov word [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 0], BIB_TLV_BOOT_OPTIONS
    90 000000F1 66C706BC5010000000          mov dword [BOOT_INFO_ADDRESS + BIB_OPTIONS_OFFSET + 4], BIB_BOOT_OPTIONS_SIZE
    91 000000FA C3                          ret
    92                                  
    93                                  collect_memory_map:
    94 000000FB 31C0                        xor ax, ax
    95 000000FD 8EC0                        mov es, ax
    96 000000FF BF0058                      mov di, MEMORY_MAP_ADDRESS
    97 00000102 6631DB                      xor ebx, ebx
    98 00000105 31ED                        xor bp, bp
    99                                  
   100                                  .next:
   101 00000107 83FD40                      cmp bp, MEMORY_MAP_MAX_ENTRIES
   102 0000010A 733C                        jae .done
   103                                  
   104 0000010C 66B820E80000                mov eax, 0x0000E820
   105 00000112 66BA50414D53                mov edx, 0x534D4150             ; "SMAP"
   106 00000118 66B918000000                mov ecx, MEMORY_MAP_ENTRY_SIZE
   107 0000011E CD15                        int 0x15
   108 00000120 7226                        jc .done
   109 00000122 663D50414D53                cmp eax, 0x534D4150
   110 00000128 751E                        jne .done
   111 0000012A 6683F914                    cmp ecx, 20
   112 0000012E 7218                        jb .done
   113                                  
   114 00000130 6683F918                    cmp ecx, MEMORY_MAP_ENTRY_SIZE
   115 00000134 7309                        jae .entry_complete
   116 00000136 2666C7451401000000          mov dword [es:di + 20], 1
   117                                  
   118                                  .entry_complete:
   119 0000013F 45                          inc bp
   120 00000140 83C718                      add di, MEMORY_MAP_ENTRY_SIZE
   121 00000143 6685DB                      test ebx, ebx
   122 00000146 75BF                        jnz .next
   123                                  
   124                                  .done:
   125 00000148 31C0                        xor ax, ax
   126 0000014A 8ED8                        mov ds, ax
   127 0000014C 8EC0                        mov es, ax
   128 0000014E 660FB7C5                    movzx eax, bp
   129 00000152 66A34450                    mov dword [BOOT_INFO_ADDRESS + BIB_MEMORY_OFFSET + 12], eax
   130 00000156 85ED                        test bp, bp
   131 00000158 7509                        jnz .success
   132 0000015A BE[582E]                    mov si, message_memory_error
   133 0000015D E86E2C                      call print_string
   134 00000160 E9812C                      jmp fatal_halt
   135                                  
   136                                  .success:
   137 00000163 C3                          ret
   138                                  
   139                                  ; ---------------------------------------------------------------------------
   140                                  ; VBE. Ein Fehler ist recoverable und aktiviert den Textmodus-Fallback.
   141                                  ; ---------------------------------------------------------------------------
   142                                  
   143                                  initialize_vbe:
   144 00000164 B8014F                      mov ax, 0x4F01
   145 00000167 B94301                      mov cx, VBE_REQUESTED_MODE
   146 0000016A 31DB                        xor bx, bx
   147 0000016C 8EC3                        mov es, bx
   148 0000016E BF0060                      mov di, VBE_MODE_INFO_ADDRESS
   149 00000171 CD10                        int 0x10
   150 00000173 83F84F                      cmp ax, 0x004F
   151 00000176 7575                        jne .fallback
   152                                  
   153 00000178 31C0                        xor ax, ax
   154 0000017A 8ED8                        mov ds, ax
   155 0000017C 8EC0                        mov es, ax
   156 0000017E A10060                      mov ax, [VBE_MODE_INFO_ADDRESS]
   157 00000181 A90100                      test ax, 0x0001
   158 00000184 7467                        jz .fallback
   159 00000186 A98000                      test ax, 0x0080
   160 00000189 7462                        jz .fallback
   161 0000018B 803E196020                  cmp byte [VBE_MODE_INFO_ADDRESS + 25], 32
   162 00000190 755B                        jne .fallback
   163 00000192 66833E286000                cmp dword [VBE_MODE_INFO_ADDRESS + 40], 0
   164 00000198 7453                        je .fallback
   165                                  
   166 0000019A B8024F                      mov ax, 0x4F02
   167 0000019D BB4341                      mov bx, VBE_REQUESTED_MODE | 0x4000
   168 000001A0 CD10                        int 0x10
   169 000001A2 83F84F                      cmp ax, 0x004F
   170 000001A5 7546                        jne .fallback
   171                                  
   172 000001A7 31C0                        xor ax, ax
   173 000001A9 8ED8                        mov ds, ax
   174 000001AB 8EC0                        mov es, ax
   175 000001AD 66830E1C5001                or dword [BOOT_INFO_ADDRESS + BIB_OFF_FLAGS], NOVA_BOOT_FLAG_FRAMEBUFFER
   176                                  
   177 000001B3 66A12860                    mov eax, [VBE_MODE_INFO_ADDRESS + 40]
   178 000001B7 66A35850                    mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 8], eax
   179 000001BB 6631C0                      xor eax, eax
   180 000001BE A11060                      mov ax, [VBE_MODE_INFO_ADDRESS + 16]
   181 000001C1 66A35C50                    mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 12], eax
   182 000001C5 6631C0                      xor eax, eax
   183 000001C8 A11260                      mov ax, [VBE_MODE_INFO_ADDRESS + 18]
   184 000001CB 66A36050                    mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 16], eax
   185 000001CF 6631C0                      xor eax, eax
   186 000001D2 A11460                      mov ax, [VBE_MODE_INFO_ADDRESS + 20]
   187 000001D5 66A36450                    mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 20], eax
   188 000001D9 6631C0                      xor eax, eax
   189 000001DC A01960                      mov al, [VBE_MODE_INFO_ADDRESS + 25]
   190 000001DF 66A36850                    mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 24], eax
   191 000001E3 66C7066C5001000000          mov dword [BOOT_INFO_ADDRESS + BIB_GRAPHICS_OFFSET + 28], NOVA_PIXEL_FORMAT_BGRX8888
   192 000001EC C3                          ret
   193                                  
   194                                  .fallback:
   195 000001ED B80300                      mov ax, 0x0003
   196 000001F0 CD10                        int 0x10
   197 000001F2 31C0                        xor ax, ax
   198 000001F4 8ED8                        mov ds, ax
   199 000001F6 8EC0                        mov es, ax
   200 000001F8 BE[252E]                    mov si, message_vbe_fallback
   201 000001FB E8D02B                      call print_string
   202 000001FE C3                          ret
   203                                  
   204                                  ; ---------------------------------------------------------------------------
   205                                  ; Kernel Image Loader
   206                                  ; ---------------------------------------------------------------------------
   207                                  
   208                                  load_kernel_image:
   209 000001FF E82B00                      call detect_bios_extensions
   210 00000202 721B                        jc .chs
   211 00000204 C606[F22D]03                mov byte [retry_count], DISK_RETRY_COUNT
   212                                  
   213                                  .lba_retry:
   214 00000209 BE[FC2D]                    mov si, kernel_dap
   215 0000020C B442                        mov ah, 0x42
   216 0000020E 8A16[F02D]                  mov dl, [boot_drive]
   217 00000212 CD13                        int 0x13
   218 00000214 7310                        jnc .done
   219 00000216 E8F900                      call reset_disk
   220 00000219 FE0E[F22D]                  dec byte [retry_count]
   221 0000021D 75EA                        jnz .lba_retry
   222                                  
   223                                  .chs:
   224 0000021F E82800                      call load_kernel_chs
   225 00000222 0F82C22B                    jc kernel_load_error
   226                                  
   227                                  .done:
   228 00000226 31C0                        xor ax, ax
   229 00000228 8ED8                        mov ds, ax
   230 0000022A 8EC0                        mov es, ax
   231 0000022C C3                          ret
   232                                  
   233                                  detect_bios_extensions:
   234 0000022D B441                        mov ah, 0x41
   235 0000022F BBAA55                      mov bx, 0x55AA
   236 00000232 8A16[F02D]                  mov dl, [boot_drive]
   237 00000236 CD13                        int 0x13
   238 00000238 720E                        jc .missing
   239 0000023A 81FB55AA                    cmp bx, 0xAA55
   240 0000023E 7508                        jne .missing
   241 00000240 F7C10100                    test cx, 1
   242 00000244 7402                        jz .missing
   243 00000246 F8                          clc
   244 00000247 C3                          ret
   245                                  .missing:
   246 00000248 F9                          stc
   247 00000249 C3                          ret
   248                                  
   249                                  load_kernel_chs:
   250 0000024A E87900                      call get_disk_geometry
   251 0000024D C706[F32D]0000              mov word [kernel_destination_offset], KERNEL_TEMP_OFFSET
   252                                  
   253                                      ; KERNEL_FIRST_LBA in die vom BIOS gemeldete CHS-Geometrie umrechnen.
   254 00000253 B82100                      mov ax, KERNEL_FIRST_LBA
   255 00000256 31D2                        xor dx, dx
   256 00000258 31DB                        xor bx, bx
   257 0000025A 8A1E[F92D]                  mov bl, [sectors_per_track]
   258 0000025E F7F3                        div bx
   259 00000260 FEC2                        inc dl
   260 00000262 8816[F72D]                  mov [kernel_sector], dl
   261 00000266 31D2                        xor dx, dx
   262 00000268 31DB                        xor bx, bx
   263 0000026A 8A1E[FA2D]                  mov bl, [maximum_head]
   264 0000026E 43                          inc bx
   265 0000026F F7F3                        div bx
   266 00000271 A2[F52D]                    mov [kernel_cylinder], al
   267 00000274 8816[F62D]                  mov [kernel_head], dl
   268 00000278 C606[F82D]41                mov byte [kernel_remaining], KERNEL_IMAGE_SECTOR_COUNT
   269                                  
   270                                  .next_sector:
   271 0000027D 803E[F82D]00                cmp byte [kernel_remaining], 0
   272 00000282 7440                        je .success
   273 00000284 C606[F22D]03                mov byte [retry_count], DISK_RETRY_COUNT
   274                                  .retry:
   275 00000289 B80010                      mov ax, KERNEL_TEMP_SEGMENT
   276 0000028C 8EC0                        mov es, ax
   277 0000028E 8B1E[F32D]                  mov bx, [kernel_destination_offset]
   278 00000292 B402                        mov ah, 0x02
   279 00000294 B001                        mov al, 1
   280 00000296 8A2E[F52D]                  mov ch, [kernel_cylinder]
   281 0000029A 8A0E[F72D]                  mov cl, [kernel_sector]
   282 0000029E 8A36[F62D]                  mov dh, [kernel_head]
   283 000002A2 8A16[F02D]                  mov dl, [boot_drive]
   284 000002A6 CD13                        int 0x13
   285 000002A8 730B                        jnc .loaded
   286 000002AA E86500                      call reset_disk
   287 000002AD FE0E[F22D]                  dec byte [retry_count]
   288 000002B1 75D6                        jnz .retry
   289 000002B3 F9                          stc
   290 000002B4 C3                          ret
   291                                  .loaded:
   292 000002B5 8106[F32D]0002              add word [kernel_destination_offset], 512
   293 000002BB E82A00                      call advance_chs
   294 000002BE FE0E[F82D]                  dec byte [kernel_remaining]
   295 000002C2 EBB9                        jmp .next_sector
   296                                  .success:
   297 000002C4 F8                          clc
   298 000002C5 C3                          ret
   299                                  
   300                                  get_disk_geometry:
   301 000002C6 C606[F92D]12                mov byte [sectors_per_track], 18
   302 000002CB C606[FA2D]01                mov byte [maximum_head], 1
   303 000002D0 B408                        mov ah, 0x08
   304 000002D2 8A16[F02D]                  mov dl, [boot_drive]
   305 000002D6 CD13                        int 0x13
   306 000002D8 720D                        jc .done
   307 000002DA 88C8                        mov al, cl
   308 000002DC 243F                        and al, 0x3F
   309 000002DE 7407                        jz .done
   310 000002E0 A2[F92D]                    mov [sectors_per_track], al
   311 000002E3 8836[FA2D]                  mov [maximum_head], dh
   312                                  .done:
   313 000002E7 C3                          ret
   314                                  
