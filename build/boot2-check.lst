   204                                  ; ---------------------------------------------------------------------------
   205                                  ; Kernel Image Loader
   206                                  ; ---------------------------------------------------------------------------
   207                                  
   208                                  load_kernel_image:
   209 000001FF E82B00                      call detect_bios_extensions
   210 00000202 721B                        jc .chs
   211 00000204 C606[310B]03                mov byte [retry_count], DISK_RETRY_COUNT
   212                                  
   213                                  .lba_retry:
   214 00000209 BE[3C0B]                    mov si, kernel_dap
   215 0000020C B442                        mov ah, 0x42
   216 0000020E 8A16[300B]                  mov dl, [boot_drive]
   217 00000212 CD13                        int 0x13
   218 00000214 7310                        jnc .done
   219 00000216 E8E300                      call reset_disk
   220 00000219 FE0E[310B]                  dec byte [retry_count]
   221 0000021D 75EA                        jnz .lba_retry
   222                                  
   223                                  .chs:
   224 0000021F E82800                      call load_kernel_chs
   225 00000222 0F820209                    jc kernel_load_error
   226                                  
   227                                  .done:
   228 00000226 31C0                        xor ax, ax
   229 00000228 8ED8                        mov ds, ax
   230 0000022A 8EC0                        mov es, ax
   231 0000022C C3                          ret
   232                                  
   233                                  detect_bios_extensions:
   234 0000022D B441                        mov ah, 0x41
   235 0000022F BBAA55                      mov bx, 0x55AA
   236 00000232 8A16[300B]                  mov dl, [boot_drive]
   237 00000236 CD13                        int 0x13
   238 00000238 720E                        jc .missing
   239 0000023A 81FB55AA                    cmp bx, 0xAA55
   240 0000023E 7508                        jne .missing
   241 00000240 F7C10100                    test cx, 1
   242 00000244 7402                        jz .missing
   243 00000246 F8                          clc
   244 00000247 C3                          ret
   245                                  .missing:
   246 00000248 F9                          stc
   247 00000249 C3                          ret
   248                                  
   249                                  load_kernel_chs:
   250 0000024A E86300                      call get_disk_geometry
   251 0000024D C706[320B]0000              mov word [kernel_destination_offset], KERNEL_TEMP_OFFSET
   252 00000253 C606[340B]00                mov byte [kernel_cylinder], 0
   253 00000258 C606[350B]00                mov byte [kernel_head], 0
   254 0000025D C606[360B]12                mov byte [kernel_sector], KERNEL_FIRST_LBA + 1
   255 00000262 C606[370B]41                mov byte [kernel_remaining], KERNEL_IMAGE_SECTOR_COUNT
   256                                  
   257                                  .next_sector:
   258 00000267 803E[370B]00                cmp byte [kernel_remaining], 0
   259 0000026C 7440                        je .success
   260 0000026E C606[310B]03                mov byte [retry_count], DISK_RETRY_COUNT
   261                                  .retry:
   262 00000273 B80010                      mov ax, KERNEL_TEMP_SEGMENT
   263 00000276 8EC0                        mov es, ax
   264 00000278 8B1E[320B]                  mov bx, [kernel_destination_offset]
   265 0000027C B402                        mov ah, 0x02
   266 0000027E B001                        mov al, 1
   267 00000280 8A2E[340B]                  mov ch, [kernel_cylinder]
   268 00000284 8A0E[360B]                  mov cl, [kernel_sector]
   269 00000288 8A36[350B]                  mov dh, [kernel_head]
   270 0000028C 8A16[300B]                  mov dl, [boot_drive]
   271 00000290 CD13                        int 0x13
   272 00000292 730B                        jnc .loaded
   273 00000294 E86500                      call reset_disk
   274 00000297 FE0E[310B]                  dec byte [retry_count]
   275 0000029B 75D6                        jnz .retry
   276 0000029D F9                          stc
   277 0000029E C3                          ret
   278                                  .loaded:
   279 0000029F 8106[320B]0002              add word [kernel_destination_offset], 512
   280 000002A5 E82A00                      call advance_chs
   281 000002A8 FE0E[370B]                  dec byte [kernel_remaining]
   282 000002AC EBB9                        jmp .next_sector
   283                                  .success:
   284 000002AE F8                          clc
   285 000002AF C3                          ret
   286                                  
   287                                  get_disk_geometry:
   288 000002B0 C606[380B]12                mov byte [sectors_per_track], 18
   289 000002B5 C606[390B]01                mov byte [maximum_head], 1
   290 000002BA B408                        mov ah, 0x08
   291 000002BC 8A16[300B]                  mov dl, [boot_drive]
   292 000002C0 CD13                        int 0x13
   293 000002C2 720D                        jc .done
   294 000002C4 88C8                        mov al, cl
   295 000002C6 243F                        and al, 0x3F
   296 000002C8 7407                        jz .done
   297 000002CA A2[380B]                    mov [sectors_per_track], al
   298 000002CD 8836[390B]                  mov [maximum_head], dh
   299                                  .done:
   300 000002D1 C3                          ret
   301                                  
   302                                  advance_chs:
   303 000002D2 FE06[360B]                  inc byte [kernel_sector]
   304 000002D6 A0[380B]                    mov al, [sectors_per_track]
   305 000002D9 3806[360B]                  cmp byte [kernel_sector], al
   306 000002DD 761C                        jbe .done
   307 000002DF C606[360B]01                mov byte [kernel_sector], 1
   308 000002E4 A0[390B]                    mov al, [maximum_head]
   309 000002E7 3806[350B]                  cmp byte [kernel_head], al
   310 000002EB 720A                        jb .next_head
   311 000002ED C606[350B]00                mov byte [kernel_head], 0
   312 000002F2 FE06[340B]                  inc byte [kernel_cylinder]
   313 000002F6 C3                          ret
   314                                  .next_head:
   315 000002F7 FE06[350B]                  inc byte [kernel_head]
   316                                  .done:
