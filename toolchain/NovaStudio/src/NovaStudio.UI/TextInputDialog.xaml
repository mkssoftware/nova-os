<Window x:Class="NovaStudio.UI.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Studio" Width="420" Height="170"
        Style="{StaticResource NovaWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!-- Wiederverwendbarer Eingabe-Dialog fuer Explorer-Operationen (Neue
         Datei/Neuer Ordner/Umbenennen) - WPF hat kein eingebautes InputBox,
         siehe auch CommitDialog.xaml fuer dasselbe Muster. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="Name:" FontSize="14" Margin="0,0,0,8"/>
            <TextBox x:Name="ValueBox" KeyDown="OnValueBoxKeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Abbrechen" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="OK" Padding="14,6" Click="OnOkClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
