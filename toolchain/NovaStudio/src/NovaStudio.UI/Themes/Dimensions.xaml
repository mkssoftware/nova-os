<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Groessenverhaeltnisse aus Abschnitt 4 der GUI-Designspezifikation.
         Alle Werte in DIP (Device Independent Pixels), wie im Auftrag
         gefordert - WPF rechnet DIP bei abweichendem DPI automatisch um,
         die hier festgelegten Verhaeltnisse bleiben dadurch erhalten. -->
    <sys:Double x:Key="TitleBarHeight">42</sys:Double>
    <sys:Double x:Key="RibbonTabHeight">38</sys:Double>
    <sys:Double x:Key="RibbonContentHeight">112</sys:Double>
    <sys:Double x:Key="RibbonToWorkspaceGap">8</sys:Double>
    <sys:Double x:Key="SolutionExplorerWidth">305</sys:Double>
    <sys:Double x:Key="RightToolPanelWidth">345</sys:Double>
    <sys:Double x:Key="DocumentTabHeight">29</sys:Double>
    <sys:Double x:Key="BreadcrumbHeight">32</sys:Double>
    <sys:Double x:Key="OutputPanelHeight">168</sys:Double>
    <sys:Double x:Key="StatusBarHeight">34</sys:Double>
    <sys:Double x:Key="PanelGap">8</sys:Double>
    <sys:Double x:Key="OuterMargin">10</sys:Double>
    <sys:Double x:Key="WindowCornerRadius">14</sys:Double>
    <sys:Double x:Key="RibbonCornerRadius">8</sys:Double>
    <sys:Double x:Key="PanelCornerRadius">7</sys:Double>
    <sys:Double x:Key="DocTabCornerRadius">7</sys:Double>
    <sys:Double x:Key="IntelliSenseCornerRadius">6</sys:Double>
    <sys:Double x:Key="StatusBarCornerRadius">6</sys:Double>
    <sys:Double x:Key="LineNumberWidth">48</sys:Double>
    <sys:Double x:Key="ScrollBarWidth">8</sys:Double>

    <!-- CornerRadius-Werte als eigener Typ (nicht als sys:Double) -
         WPFs TypeConverter fuer CornerRadius greift nur bei literalen
         XAML-Strings, NICHT bei einem per {StaticResource} aufgeloesten
         Double-Objekt zur Laufzeit (fuehrte zu einer echten
         InvalidOperationException beim ersten Start, siehe
         IMPLEMENTATION_STATUS.md). -->
    <CornerRadius x:Key="WindowCornerRadiusValue">14</CornerRadius>
    <CornerRadius x:Key="RibbonCornerRadiusValue">8</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadiusValue">7</CornerRadius>
    <CornerRadius x:Key="DocTabCornerRadiusValue">7,7,0,0</CornerRadius>
    <CornerRadius x:Key="IntelliSenseCornerRadiusValue">6</CornerRadius>
    <CornerRadius x:Key="StatusBarCornerRadiusValue">6</CornerRadius>
</ResourceDictionary>
