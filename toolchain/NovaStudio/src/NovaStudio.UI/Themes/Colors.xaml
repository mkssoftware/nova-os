<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Nova Dark – zentrale Farbpalette (Abschnitt 3 der GUI-Designspezifikation).
        Jede Farbe hier entspricht EXAKT dem im Auftrag genannten Hex-Wert.
        Keine Farbe darf direkt in einem Control hartkodiert werden - immer
        ueber diese Ressourcen (DynamicResource) beziehen, damit ein
        zukuenftiges Hell-Design (NovaLight.xaml) moeglich bleibt.
    -->
    <Color x:Key="ApplicationBackgroundColor">#10131F</Color>
    <Color x:Key="WindowBackgroundColor">#151824</Color>
    <Color x:Key="TitleBarBackgroundColor">#191A2C</Color>
    <Color x:Key="TitleBarGradientEndColor">#30213F</Color>
    <Color x:Key="RibbonBackgroundColor">#25283B</Color>
    <Color x:Key="RibbonGradientEndColor">#382A4C</Color>
    <Color x:Key="RibbonTabBackgroundColor">#1B1D2D</Color>
    <Color x:Key="RibbonTabSelectedColor">#393954</Color>
    <Color x:Key="EditorBackgroundColor">#141722</Color>
    <Color x:Key="EditorCurrentLineColor">#252838</Color>
    <Color x:Key="EditorTabBackgroundColor">#202332</Color>
    <Color x:Key="EditorTabSelectedColor">#303047</Color>
    <Color x:Key="PanelBackgroundColor">#191D2A</Color>
    <Color x:Key="PanelHeaderBackgroundColor">#252938</Color>
    <Color x:Key="PanelSecondaryBackgroundColor">#202432</Color>
    <Color x:Key="PanelBorderColor">#3C4054</Color>
    <Color x:Key="SeparatorColorValue">#343849</Color>
    <Color x:Key="PrimaryTextColor">#E5E7F0</Color>
    <Color x:Key="SecondaryTextColor">#B9BFCE</Color>
    <Color x:Key="MutedTextColor">#858DA3</Color>
    <Color x:Key="AccentPrimaryColor">#A58AFF</Color>
    <Color x:Key="AccentSecondaryColor">#829DFF</Color>
    <Color x:Key="AccentGlowColor">#B99AFF</Color>
    <Color x:Key="SelectionBackgroundColor">#363957</Color>
    <Color x:Key="SelectionBorderColor">#54577C</Color>
    <Color x:Key="HoverBackgroundColor">#30364A</Color>
    <Color x:Key="IntelliSenseBackgroundColor">#252A39</Color>
    <Color x:Key="IntelliSenseSelectionColor">#315AC4</Color>
    <Color x:Key="IntelliSenseBorderColor">#535B73</Color>
    <Color x:Key="SuccessColorValue">#72D66D</Color>
    <Color x:Key="WarningColorValue">#FFCC45</Color>
    <Color x:Key="ErrorColorValue">#FF555D</Color>
    <Color x:Key="InformationColorValue">#62AEFF</Color>
    <Color x:Key="FolderColorValue">#E9B85D</Color>

    <!-- Zusaetzliche, im Auftrag an anderer Stelle genannte Einzelwerte -->
    <Color x:Key="WindowBorderColor">#50465F</Color>
    <Color x:Key="RibbonBorderColor">#393D50</Color>
    <Color x:Key="DocTabActiveBorderColor">#7862A7</Color>
    <Color x:Key="DocTabInactiveTextColor">#C5CAD7</Color>
    <Color x:Key="GroupLabelColor">#A8ACBC</Color>
    <Color x:Key="IntelliSenseSelectedBorderColor">#5778DB</Color>
    <Color x:Key="ScrollBarThumbColor">#50566A</Color>
    <Color x:Key="CategoryHeaderColor">#292D3E</Color>
    <Color x:Key="StatusBarGradientLeftColor">#202D32</Color>
    <Color x:Key="StatusBarGradientMidColor">#202433</Color>
    <Color x:Key="StatusBarGradientRightColor">#252638</Color>
    <Color x:Key="SymbolSearchBackgroundColor">#242838</Color>
    <Color x:Key="SymbolSearchBorderColor">#41465A</Color>
    <Color x:Key="ErrorRowAltColor">#1C202D</Color>
    <Color x:Key="ErrorRowColor">#202432</Color>

    <!-- Syntaxfarben (Abschnitt 12) -->
    <Color x:Key="SyntaxKeywordColor">#75C8F5</Color>
    <Color x:Key="SyntaxClassColor">#D69BEA</Color>
    <Color x:Key="SyntaxTypeColor">#62E3C6</Color>
    <Color x:Key="SyntaxFunctionColor">#E8D8A0</Color>
    <Color x:Key="SyntaxPropertyColor">#9FC7FF</Color>
    <Color x:Key="SyntaxVariableColor">#DCE3F1</Color>
    <Color x:Key="SyntaxParameterColor">#C5B8F0</Color>
    <Color x:Key="SyntaxCommentColor">#83D36D</Color>
    <Color x:Key="SyntaxStringColor">#E6B87D</Color>
    <Color x:Key="SyntaxNumberColor">#B7DFA0</Color>
    <Color x:Key="SyntaxOperatorColor">#C5CAD7</Color>
    <Color x:Key="SyntaxBracketColor">#D6DAE5</Color>
</ResourceDictionary>
