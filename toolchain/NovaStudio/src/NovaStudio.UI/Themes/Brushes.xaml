<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Solide Pinsel, direkt aus Colors.xaml abgeleitet -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorderColor}"/>
    <SolidColorBrush x:Key="RibbonTabBackgroundBrush" Color="{StaticResource RibbonTabBackgroundColor}"/>
    <SolidColorBrush x:Key="RibbonTabSelectedBrush" Color="{StaticResource RibbonTabSelectedColor}"/>
    <SolidColorBrush x:Key="RibbonBorderBrush" Color="{StaticResource RibbonBorderColor}"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}"/>
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="{StaticResource EditorCurrentLineColor}"/>
    <SolidColorBrush x:Key="EditorTabBackgroundBrush" Color="{StaticResource EditorTabBackgroundColor}"/>
    <SolidColorBrush x:Key="EditorTabSelectedBrush" Color="{StaticResource EditorTabSelectedColor}"/>
    <SolidColorBrush x:Key="DocTabActiveBorderBrush" Color="{StaticResource DocTabActiveBorderColor}"/>
    <SolidColorBrush x:Key="DocTabInactiveTextBrush" Color="{StaticResource DocTabInactiveTextColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="{StaticResource PanelHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelSecondaryBackgroundBrush" Color="{StaticResource PanelSecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColorValue}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="GroupLabelBrush" Color="{StaticResource GroupLabelColor}"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="IntelliSenseBackgroundBrush" Color="{StaticResource IntelliSenseBackgroundColor}"/>
    <SolidColorBrush x:Key="IntelliSenseSelectionBrush" Color="{StaticResource IntelliSenseSelectionColor}"/>
    <SolidColorBrush x:Key="IntelliSenseBorderBrush" Color="{StaticResource IntelliSenseBorderColor}"/>
    <SolidColorBrush x:Key="IntelliSenseSelectedBorderBrush" Color="{StaticResource IntelliSenseSelectedBorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColorValue}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorValue}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColorValue}"/>
    <SolidColorBrush x:Key="InformationBrush" Color="{StaticResource InformationColorValue}"/>
    <SolidColorBrush x:Key="FolderBrush" Color="{StaticResource FolderColorValue}"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="CategoryHeaderBrush" Color="{StaticResource CategoryHeaderColor}"/>
    <SolidColorBrush x:Key="SymbolSearchBackgroundBrush" Color="{StaticResource SymbolSearchBackgroundColor}"/>
    <SolidColorBrush x:Key="SymbolSearchBorderBrush" Color="{StaticResource SymbolSearchBorderColor}"/>
    <SolidColorBrush x:Key="ErrorRowAltBrush" Color="{StaticResource ErrorRowAltColor}"/>
    <SolidColorBrush x:Key="ErrorRowBrush" Color="{StaticResource ErrorRowColor}"/>

    <!-- Syntax-Pinsel -->
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="{StaticResource SyntaxKeywordColor}"/>
    <SolidColorBrush x:Key="SyntaxClassBrush" Color="{StaticResource SyntaxClassColor}"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="{StaticResource SyntaxTypeColor}"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="{StaticResource SyntaxFunctionColor}"/>
    <SolidColorBrush x:Key="SyntaxPropertyBrush" Color="{StaticResource SyntaxPropertyColor}"/>
    <SolidColorBrush x:Key="SyntaxVariableBrush" Color="{StaticResource SyntaxVariableColor}"/>
    <SolidColorBrush x:Key="SyntaxParameterBrush" Color="{StaticResource SyntaxParameterColor}"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="{StaticResource SyntaxCommentColor}"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="{StaticResource SyntaxStringColor}"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="{StaticResource SyntaxNumberColor}"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="{StaticResource SyntaxOperatorColor}"/>
    <SolidColorBrush x:Key="SyntaxBracketBrush" Color="{StaticResource SyntaxBracketColor}"/>

    <!-- Farbverlaeufe (Abschnitt 5/7/18) -->
    <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#191A2C" Offset="0"/>
        <GradientStop Color="#1C1D30" Offset="0.5"/>
        <GradientStop Color="#30213F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#292D40" Offset="0"/>
        <GradientStop Color="#25283B" Offset="0.5"/>
        <GradientStop Color="#382A4C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatusBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource StatusBarGradientLeftColor}" Offset="0"/>
        <GradientStop Color="{StaticResource StatusBarGradientMidColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource StatusBarGradientRightColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonTabSelectedGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3F3F60" Offset="0"/>
        <GradientStop Color="{StaticResource RibbonTabSelectedColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DocTabActiveGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36365A" Offset="0"/>
        <GradientStop Color="{StaticResource EditorTabSelectedColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PanelHeaderBackgroundColor}" Offset="0"/>
        <GradientStop Color="#2A2E40" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EditorBackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource EditorBackgroundColor}" Offset="0"/>
        <GradientStop Color="#191C29" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
