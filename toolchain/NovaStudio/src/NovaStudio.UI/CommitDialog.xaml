<Window x:Class="NovaStudio.UI.CommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit" Width="480" Height="220"
        Style="{StaticResource NovaWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Text="Commit-Nachricht" FontSize="14" Margin="0,0,0,8"/>
            <TextBox x:Name="MessageBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Abbrechen" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Commit erstellen" Padding="14,6" Click="OnCommitClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
