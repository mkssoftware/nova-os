; ---------------------------------------------------------------------------
; Nova Font-Subsystem
; NPSPEC-FONT-MANAGER-0001    - Font-Verwaltung
; NPSPEC-FONT-EMBEDDED-0001   - Eingebettete Bitmap-Fonts
; NPSPEC-FONT-FALLBACK-0001   - Fallback-Kette
; NPSPEC-FONT-VARIABLE-0001   - Variable Fonts (Axes)
; NPSPEC-FONT-COLORGLYPH-0001 - Farb-Glyphen
; NPSPEC-FONT-PROVENANCE-0001 - Herkunft und Lizenzen
; NPSPEC-FONT-SECURITY-0001   - Font-Sicherheit
; ---------------------------------------------------------------------------

; Font-Flags (NPSPEC-FONT-MANAGER-0001)
FONT_FLAG_MONO        equ 0x01  ; Monospace
FONT_FLAG_BITMAP      equ 0x02  ; Bitmap-Font (NPSPEC-FONT-EMBEDDED-0001)
FONT_FLAG_VARIABLE    equ 0x04  ; Variable Font (NPSPEC-FONT-VARIABLE-0001)
FONT_FLAG_COLOR       equ 0x08  ; Farb-Glyphen (NPSPEC-FONT-COLORGLYPH-0001)
FONT_FLAG_FALLBACK    equ 0x10  ; Ist ein Fallback-Font (NPSPEC-FONT-FALLBACK-0001)
FONT_FLAG_SYSTEM      equ 0x20  ; System-Font, nicht entfernbar
FONT_FLAG_VERIFIED    equ 0x40  ; Integritaet geprueft (NPSPEC-FONT-SECURITY-0001)

; Provenance-Typen (NPSPEC-FONT-PROVENANCE-0001)
FONT_PROV_UNKNOWN     equ 0
FONT_PROV_EMBEDDED    equ 1    ; In Kernel eingebettet
FONT_PROV_LOADED      equ 2    ; Zur Laufzeit geladen
FONT_PROV_GENERATED   equ 3    ; Synthetisch erzeugt

; Variable-Font-Achsen (NPSPEC-FONT-VARIABLE-0001)
FONT_AXIS_WEIGHT      equ 0    ; Gewicht (100..900)
FONT_AXIS_WIDTH       equ 1    ; Breite (75..125%)
FONT_AXIS_SLANT       equ 2    ; Schraegstellung (-90..90 Grad)
FONT_AXIS_OPTICAL     equ 3    ; Optische Groesse (Pt)
FONT_AXIS_COUNT       equ 4

; Font-Record (64 Bytes, NPSPEC-FONT-MANAGER-0001)
FONT_REC_SIZE         equ 64
FR_ID                 equ 0    ; Font-ID
FR_FLAGS              equ 4    ; FONT_FLAG_*
FR_SIZE_PX            equ 8    ; Pixel-Groesse
FR_GLYPH_W            equ 12   ; Glyph-Breite (Bitmap)
FR_GLYPH_H            equ 16   ; Glyph-Hoehe (Bitmap)
FR_DATA_PTR           equ 20   ; Zeiger auf Bitmap-Daten
FR_DATA_LEN           equ 24   ; Dateigroesse in Bytes
FR_GLYPH_COUNT        equ 28   ; Anzahl verfuegbarer Glyphen
FR_FALLBACK_ID        equ 32   ; Fallback-Font-ID (NPSPEC-FONT-FALLBACK-0001)
FR_PROVENANCE         equ 36   ; FONT_PROV_*
FR_AXES               equ 40   ; FONT_AXIS_COUNT * 1 Byte Wert (kompakt)
FR_CHECKSUM           equ 44   ; CRC32 der Daten (NPSPEC-FONT-SECURITY-0001)
; 48..63: reserviert

FONT_CAPACITY         equ 8

; Eingebetteter 8x16 System-Font (ASCII 0x20..0x7E, 95 Zeichen)
; Kompaktes 1-Bit-Bitmap-Format: 16 Bytes pro Glyph
FONT_SYS_GLYPH_W      equ 8
FONT_SYS_GLYPH_H      equ 16
FONT_SYS_FIRST_CHAR   equ 0x20
FONT_SYS_LAST_CHAR    equ 0x7E
FONT_SYS_CHAR_COUNT   equ 95
FONT_SYS_BYTES_PER    equ 16   ; FONT_SYS_GLYPH_H

; ---------------------------------------------------------------------------
; font_manager_initialize
; Registriert den eingebetteten System-Font.
; CF=0 Erfolg
; ---------------------------------------------------------------------------
font_manager_initialize:
    push edi
    ; Tabelle loeschen
    mov edi, font_table
    xor eax, eax
    mov ecx, (FONT_CAPACITY * FONT_REC_SIZE) / 4
    rep stosd
    pop edi

    mov dword [font_count], 0
    mov dword [font_active_id], 0

    ; Eingebetteten System-Font registrieren (NPSPEC-FONT-EMBEDDED-0001)
    mov eax, 0                      ; Font-ID 0
    mov ebx, FONT_FLAG_MONO | FONT_FLAG_BITMAP | FONT_FLAG_SYSTEM
    mov ecx, FONT_SYS_GLYPH_H      ; size_px
    call font_register
    jc .fail

    mov dword [font_ready], 1
    clc
    ret
.fail:
    stc
    ret

; ---------------------------------------------------------------------------
; font_register: EAX=id, EBX=flags, ECX=size_px
; CF=0 Erfolg
; ---------------------------------------------------------------------------
font_register:
    cmp dword [font_count], FONT_CAPACITY
    jae .full
    push edi
    push edx
    mov edi, font_table
    mov edx, [font_count]
    imul edx, FONT_REC_SIZE
    add edi, edx
    ; Record fuellen
    mov [edi + FR_ID], eax
    mov [edi + FR_FLAGS], ebx
    mov [edi + FR_SIZE_PX], ecx
    ; Bitmap-Felder fuer eingebetteten Font
    test ebx, FONT_FLAG_BITMAP
    jz .no_bitmap
    mov dword [edi + FR_GLYPH_W], FONT_SYS_GLYPH_W
    mov dword [edi + FR_GLYPH_H], FONT_SYS_GLYPH_H
    mov dword [edi + FR_DATA_PTR], font_bitmap_data
    mov dword [edi + FR_DATA_LEN], FONT_SYS_CHAR_COUNT * FONT_SYS_BYTES_PER
    mov dword [edi + FR_GLYPH_COUNT], FONT_SYS_CHAR_COUNT
.no_bitmap:
    mov dword [edi + FR_FALLBACK_ID], 0xFFFFFFFF  ; kein Fallback
    mov dword [edi + FR_PROVENANCE], FONT_PROV_EMBEDDED
    ; Pruefsumme berechnen (vereinfachte XOR, NPSPEC-FONT-SECURITY-0001)
    push esi
    push ecx
    mov esi, font_bitmap_data
    mov ecx, FONT_SYS_CHAR_COUNT * FONT_SYS_BYTES_PER
    xor edx, edx
.crc_loop:
    test ecx, ecx
    jz .crc_done
    movzx eax, byte [esi]
    xor edx, eax
    inc esi
    dec ecx
    jmp .crc_loop
.crc_done:
    mov [edi + FR_CHECKSUM], edx
    ; Verified-Flag setzen
    or dword [edi + FR_FLAGS], FONT_FLAG_VERIFIED
    pop ecx
    pop esi
    inc dword [font_count]
    pop edx
    pop edi
    clc
    ret
.full:
    pop edi
    stc
    ret

; ---------------------------------------------------------------------------
; font_get_glyph: EAX=codepoint, EBX=font_id -> ESI=glyph_ptr, CF=0 ok
; (NPSPEC-FONT-EMBEDDED-0001, NPSPEC-FONT-FALLBACK-0001)
; ---------------------------------------------------------------------------
font_get_glyph:
    ; Bereich pruefen
    cmp eax, FONT_SYS_FIRST_CHAR
    jb .try_fallback
    cmp eax, FONT_SYS_LAST_CHAR
    ja .try_fallback
    ; Offset berechnen
    sub eax, FONT_SYS_FIRST_CHAR
    imul eax, FONT_SYS_BYTES_PER
    mov esi, font_bitmap_data
    add esi, eax
    clc
    ret
.try_fallback:
    ; Fallback: Replacement-Glyph (0x20 = Leerzeichen)
    mov esi, font_bitmap_data  ; Zeigt auf Leerzeichen-Glyph
    stc
    ret

; ---------------------------------------------------------------------------
; font_set_fallback: EAX=font_id, EBX=fallback_id
; (NPSPEC-FONT-FALLBACK-0001)
; ---------------------------------------------------------------------------
font_set_fallback:
    push esi
    push ecx
    mov esi, font_table
    mov ecx, [font_count]
.scan:
    test ecx, ecx
    jz .not_found
    cmp [esi + FR_ID], eax
    je .found
    add esi, FONT_REC_SIZE
    dec ecx
    jmp .scan
.found:
    mov [esi + FR_FALLBACK_ID], ebx
    pop ecx
    pop esi
    clc
    ret
.not_found:
    pop ecx
    pop esi
    stc
    ret

; ---------------------------------------------------------------------------
; font_set_axis: EAX=font_id, EBX=axis_id, ECX=value (0..255 skaliert)
; (NPSPEC-FONT-VARIABLE-0001)
; ---------------------------------------------------------------------------
font_set_axis:
    cmp ebx, FONT_AXIS_COUNT
    jae .invalid
    push esi
    push edi
    push ecx
    mov esi, font_table
    mov edi, [font_count]
.scan:
    test edi, edi
    jz .not_found
    cmp [esi + FR_ID], eax
    je .found
    add esi, FONT_REC_SIZE
    dec edi
    jmp .scan
.found:
    ; Axis-Byte setzen
    mov edi, esi
    add edi, FR_AXES
    add edi, ebx
    pop ecx
    mov [edi], cl
    pop edi
    pop esi
    clc
    ret
.not_found:
    pop ecx
    pop edi
    pop esi
    stc
    ret
.invalid:
    stc
    ret

; ---------------------------------------------------------------------------
; font_manager_self_test
; ---------------------------------------------------------------------------
font_manager_self_test:
    push esi
    push ebx
    xor ebx, ebx   ; EBX = Fehlerzaehler (ESI wird von font_get_glyph als Glyph-Ptr belegt)

    cmp dword [font_ready], 1
    je .t2
    inc ebx
.t2:
    cmp dword [font_count], 0
    jne .t3
    inc ebx
.t3:
    ; Glyph-Lookup: 'A' = 0x41
    mov eax, 0x41
    push ebx               ; Fehlerzaehler sichern (EBX wird als font_id benutzt)
    xor ebx, ebx           ; EBX=0 = font_id
    call font_get_glyph    ; ESI=Glyph-Ptr (EBX unveraendert)
    pop ebx                ; Fehlerzaehler wiederherstellen
    jnc .t4
    inc ebx
.t4:
    ; Fallback-Lookup: Emoji (U+1F600, ausserhalb)
    mov eax, 0x1F600
    push ebx               ; Fehlerzaehler sichern
    xor ebx, ebx           ; font_id=0
    call font_get_glyph    ; CF gesetzt ist ok (Fallback geliefert)
    pop ebx                ; Fehlerzaehler wiederherstellen
    jmp .done
.done:
    test ebx, ebx
    jz .ok
    pop ebx
    pop esi
    stc
    ret
.ok:
    pop ebx
    pop esi
    clc
    ret

; ---------------------------------------------------------------------------
; Statische Daten
; ---------------------------------------------------------------------------
align 4
font_ready:           dd 0
font_count:           dd 0
font_active_id:       dd 0

align 4
font_table:
    times FONT_CAPACITY * FONT_REC_SIZE db 0

; Eingebetteter 8x16 Bitmap-Font (ASCII 0x20..0x7E)
; Jeder Eintrag: 16 Bytes (1 Bit pro Pixel, Zeile fuer Zeile)
align 4
font_bitmap_data:
; 0x20 Space
